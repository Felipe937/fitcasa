# .gitignore for FitCasa project

# System files
.DS_Store
Thumbs.db

# Node modules
node_modules/

# Build output. `npm run build` lo regenera desde cero; versionarlo solo
# anade ruido al diff y termina desincronizandose del fuente.
dist/

# Informes y capturas de herramientas de diseno locales
.taste-skill/
screenshots/

# VS Code settings
.vscode/

# Log files
*.log

# Wrangler (Cloudflare Pages CLI)
.wrangler/
